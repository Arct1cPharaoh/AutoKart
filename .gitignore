# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
AutoKart/[Ll]ibrary/
AutoKart/[Tt]emp/
AutoKart/[Oo]bj/
AutoKart/[Bb]uild/
AutoKart/[Bb]uilds/
AutoKart/[Ll]ogs/
AutoKart/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
AutoKart/[Mm]emoryCaptures/

# Recordings can get excessive in size
AutoKart/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
AutoKart/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Images
AutoKart/Assets/CapturedFrames/

# === ML (AutoKart/Assets/Scripts/ML) ===
AutoKart/Assets/Scripts/ML/__pycache__/
AutoKart/Assets/Scripts/ML/*.pyc
AutoKart/Assets/Scripts/ML/.ipynb_checkpoints/
AutoKart/Assets/Scripts/ML/*.onnx
AutoKart/Assets/Scripts/ML/*.pt
AutoKart/Assets/Scripts/ML/*.pth
AutoKart/Assets/Scripts/ML/*.tflite
AutoKart/Assets/Scripts/ML/*.engine
AutoKart/Assets/Scripts/ML/*.log
AutoKart/Assets/Scripts/ML/*.csv
AutoKart/Assets/Scripts/ML/*.yaml
AutoKart/Assets/Scripts/ML/*.yml

# Exclude predictions, datasets, and training outputs
AutoKart/Assets/Scripts/ML/dataset_yolo*/
AutoKart/Assets/Scripts/ML/data/
AutoKart/Assets/Scripts/ML/fsoco-devkit/
AutoKart/Assets/Scripts/ML/runs/
AutoKart/Assets/Scripts/ML/models/

# Ban images and predictions
AutoKart/Assets/Scripts/ML/**/*.jpg
AutoKart/Assets/Scripts/ML/**/*.jpeg
AutoKart/Assets/Scripts/ML/**/*.png
AutoKart/Assets/Scripts/ML/**/*.bmp
AutoKart/Assets/Scripts/ML/**/*.gif
AutoKart/Assets/Scripts/ML/**/*.webp
AutoKart/Assets/Scripts/ML/**/*.tif
AutoKart/Assets/Scripts/ML/**/*.tiff

# Checkpoints or cached files
AutoKart/Assets/Scripts/ML/*.cache
AutoKart/Assets/Scripts/ML/*.ckpt
AutoKart/Assets/Scripts/ML/*.npy
AutoKart/Assets/Scripts/ML/*.npz

# TensorBoard logs
AutoKart/Assets/Scripts/ML/events.out.*
